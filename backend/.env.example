# Copy to .env for local development (`cp .env.example .env`). Real environment
# variables always override .env. See internal/platform/config/config.go.

# dev | test | prod. DEV_FIXED_OTP and /dev/files are only honoured in dev.
ORBIT_ENV=dev
LOG_LEVEL=info
LOG_FORMAT=text

HTTP_ADDR=:8080
# Request body cap (bytes). Only bulk routes (FA sync batch, CSV imports) get
# HTTP_LARGE_BODY_BYTES.
HTTP_MAX_BODY_BYTES=2097152
HTTP_LARGE_BODY_BYTES=5242880
# How clients reach this server (dev file URLs).
PUBLIC_BASE_URL=http://localhost:8080
# Base URL of the farmer web pages, used for links in SMS and WhatsApp
# (<base>/web/notices/{id}?t=..., the farmer-web app route). Empty means PUBLIC_BASE_URL. In prod this
# is the DLT-whitelisted link domain.
FARMER_WEB_BASE_URL=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
TRUST_PROXY_HEADERS=false

# Postgres + PostGIS and Redis from dev/docker-compose.yml (make dev-up).
DATABASE_URL=postgres://orbit:orbit@localhost:5432/orbit?sslmode=disable
DATABASE_MAX_CONNS=20
TEST_DATABASE_URL=postgres://orbit:orbit@localhost:5432/orbit_test?sslmode=disable
# Empty or unset REDIS_URL runs without Redis (cache misses, rate limits on Postgres).
REDIS_URL=redis://localhost:6379/0

# At least 32 characters. Generate one for real envs: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_ISSUER=orbit
ACCESS_TOKEN_TTL=15m
# Refresh-token lifetimes. Farmer: 90 days, sliding. FA: 30 days, sliding; the
# 7-day offline limit is the FA app's PIN rule (offline_grace_days at sign-in),
# not this. HO: a working day, absolute (not extended by refreshes).
REFRESH_TTL_FARMER=2160h
REFRESH_TTL_FA=720h
REFRESH_TTL_HO=8h
WEB_LINK_TTL=168h
OTP_TTL=5m
# Accepted as the OTP for every phone, in dev only.
DEV_FIXED_OTP=123456
# Android SMS Retriever: the farmer app's 11-character signature hash. When
# set, sign-in OTP SMS start with "<#>" and end with this hash (zero-tap read).
OTP_SMS_APP_HASH=

# App releases, served by GET /v1/auth/app-config and the device heartbeats.
# An app older than APP_MIN_VERSION_* must update first ("0.0.0" forces nothing).
# Empty latest version means the min version. Flags: name=true,other=false
APP_MIN_VERSION_FARMER=0.0.0
APP_LATEST_VERSION_FARMER=
APP_STORE_URL_FARMER=
APP_FLAGS_FARMER=
APP_MIN_VERSION_FA=0.0.0
APP_LATEST_VERSION_FA=
APP_STORE_URL_FA=
APP_FLAGS_FA=

# Encrypts HO TOTP secrets at rest: 32 random bytes, base64 (openssl rand -base64 32).
# Required in prod. This value is for dev only; never reuse it anywhere else.
TOTP_ENC_KEY=ZGV2LW9ubHktdG90cC1rZXktY2hhbmdlLW1lLTAwMDA=

# Object storage. Only "local" (disk, dev) exists; prod refuses it.
STORAGE_PROVIDER=local
# Local-disk object storage (dev). Signed URLs are served at /dev/files/*.
STORAGE_DIR=.data/storage
# Defaults to JWT_SECRET when empty.
STORAGE_SIGNING_KEY=

# Only "log" exists (prints, never sends); prod refuses it. Outside dev the log
# senders redact codes and link tokens from message bodies.
SMS_PROVIDER=log
PUSH_PROVIDER=log

WORKER_CONCURRENCY=20
# The worker serves /healthz and /readyz here for container health checks.
WORKER_HEALTH_ADDR=:8081
SHUTDOWN_TIMEOUT=20s
